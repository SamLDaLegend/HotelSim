{
  "name": "hotelsim",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r run typecheck",
    "check:purity": "node tools/gates/check-purity.mjs && depcruise --config .dependency-cruiser.cjs packages apps tools",
    "check:content": "node tools/gates/check-content.mjs",
    "check:measure": "node tools/gates/check-measure.mjs",
    "check:tickcost": "node tools/gates/tripwire.mjs",
    "check:tickcost:proof": "node tools/gates/check-tripwire.mjs",
    "check:scaling": "node tools/gates/scaling.mjs",
    "check:stamp": "node tools/gates/stamp.mjs && node tools/gates/check-status.mjs",
    "check:ladder": "node tools/gates/check-ladder.mjs",
    "check:unpinned": "node tools/gates/check-unpinned.mjs",
    "stamp:set": "node tools/gates/stamp.mjs --set",
    "test": "vitest run",
    "test:determinism": "node tools/gates/determinism.mjs",
    "test:save": "vitest run save",
    "dev": "pnpm --filter @hotelsim/game dev",
    "sim:run": "tsx tools/headless/src/cli.ts",
    "sim:bench": "node tools/gates/bench.mjs",
    "sim:measure": "node tools/gates/measure.mjs",
    "sim:needs-history": "node tools/gates/needs-history.mjs",
    "viewer": "node tools/viewer/serve.mjs",
    "verify": "node tools/gates/verify.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "dependency-cruiser": "^17.0.1",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^4.1.10"
  }
}
